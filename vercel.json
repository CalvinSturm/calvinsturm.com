{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/downloads/fastcast/0.7.0/FastCast-0.7.0-win-x64.msi",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"FastCast-0.7.0-win-x64.msi\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/LocalAgent",
      "destination": "/localagent",
      "permanent": true
    },
    {
      "source": "/FaceForge",
      "destination": "/faceforge",
      "permanent": true
    },
    {
      "source": "/VideoForge",
      "destination": "/videoforge",
      "permanent": true
    }
  ],
  "rewrites": []
}
